# ============================================================================
# VARIABLES ENVIRONNEMENT - AUTH SERVICE PRODUCTION
# ============================================================================
# ⚠️  CRITICAL - Utiliser Secrets Manager (AWS, Vault, Azure)

SPRING_PROFILES_ACTIVE=prod
SPRING_APPLICATION_NAME=auth-service

DB_HOST=${DB_HOST_PROD}
DB_PORT=5432
DB_NAME=speedline_auth_prod
SPRING_DATASOURCE_URL=${DB_URL_PROD}
SPRING_DATASOURCE_USERNAME=${DB_USERNAME_PROD}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD_PROD}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true

SPRING_DATA_REDIS_HOST=${REDIS_HOST_PROD}
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=${REDIS_PASSWORD_PROD}

# GCP Pub/Sub production (Cloud Run) - injecter GCP_PROJECT_ID via CI/CD
GCP_PROJECT_ID=${GCP_PROJECT_ID_PROD}
# In Cloud Run, service account provides credentials automatically

SPRING_MAIL_HOST=${MAIL_HOST_PROD}
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=${MAIL_USERNAME_PROD}
SPRING_MAIL_PASSWORD=${MAIL_PASSWORD_PROD}

EUREKA_USER=${EUREKA_USER_PROD}
EUREKA_PASSWORD=${EUREKA_PASSWORD_PROD}
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka:eureka123@eureka:8761/eureka/

JWT_SECRET=${JWT_SECRET_PROD}
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

OTP_EXPIRATION_MINUTES=3

GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID_PROD}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET_PROD}
FACEBOOK_APP_ID=${FACEBOOK_APP_ID_PROD}
FACEBOOK_APP_SECRET=${FACEBOOK_APP_SECRET_PROD}

MANAGEMENT_SERVER_PORT=9090
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

SERVER_PORT=8081
SERVER_SERVLET_ENCODING_CHARSET=UTF-8

LOG_LEVEL=ERROR
LOGGING_LEVEL_ROOT=ERROR
LOGGING_LEVEL_COM_SPEEDLINE=WARN
LOGGING_LEVEL_COM_SPEEDLINE_AUTH=WARN
