# ============================================================================
# VARIABLES ENVIRONNEMENT - ANALYTICS SERVICE STAGING
# ============================================================================

SPRING_PROFILES_ACTIVE=staging
SPRING_APPLICATION_NAME=analytics-service

EUREKA_USER=eureka
EUREKA_PASSWORD=eureka123
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka:eureka123@eureka:8761/eureka/

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/analytics_staging?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=analytics_user
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD_STAGING}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect

SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

MANAGEMENT_SERVER_PORT=9090
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

SERVER_PORT=8089
SERVER_SERVLET_ENCODING_CHARSET=UTF-8

LOG_LEVEL=INFO
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO
LOGGING_LEVEL_COM_SPEEDLINE=INFO


