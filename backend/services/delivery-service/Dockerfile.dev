# ==============================================================================
# Dockerfile.dev — Delivery Service (Cloud Run)
# ==============================================================================

FROM maven:3.9.6-eclipse-temurin-17 AS builder
WORKDIR /workspace

COPY . .

RUN mvn -q -DskipTests -pl services/delivery-service -am clean package

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

COPY --from=builder /workspace/services/delivery-service/target/*.jar /app/app.jar
RUN chown appuser:appuser /app/app.jar

EXPOSE 8080

# ✅ Profil dev Cloud Run
ENV SPRING_PROFILES_ACTIVE=dev
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseG1GC -Dspring.output.ansi.enabled=ALWAYS"

USER appuser
# ✅ Cloud Run injecte PORT dynamiquement - explicit JVM argument ensures proper binding
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -Dserver.port=${PORT:-8080} -jar /app/app.jar"]

