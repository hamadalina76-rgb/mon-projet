# ============================================================================
# CONFIGURATION PRODUCTION - DELIVERY SERVICE (.env.prod)
# ============================================================================
# ⚠️  CRITICAL - Utiliser Secrets Manager (GCP Secret Manager pour Pub/Sub)
# Ne JAMAIS commiter les vraies valeurs ici
# Pour Cloud Run: les credentials GCP sont injectées via Service Account
# ============================================================================

# ============================================================================
# 1️⃣  SPRING BOOT - PROFIL & APPLICATION
# ============================================================================
SPRING_PROFILES_ACTIVE=prod

# ============================================================================
# 2️⃣  BASE DE DONNÉES POSTGRESQL - VARIABLES OBLIGATOIRES
# ============================================================================
DB_HOST=${DB_HOST_PROD}
DB_USERNAME=${DB_USERNAME_PROD}
DB_PASSWORD=${DB_PASSWORD_PROD}

# ============================================================================
# 3️⃣  GOOGLE CLOUD - GCP / PUB/SUB (PRODUCTION - CLOUD RUN)
# ============================================================================
GCP_PROJECT_ID=${GCP_PROJECT_ID_PROD}
# Cloud Run injecte automatiquement les credentials via Service Account
# Pas besoin de GOOGLE_APPLICATION_CREDENTIALS

# ============================================================================
# 4️⃣  EUREKA SERVER - DÉCOUVERTE DE SERVICES
# ============================================================================
EUREKA_USER=${EUREKA_USER_PROD}
EUREKA_PASSWORD=${EUREKA_PASSWORD_PROD}

# ============================================================================
# 5️⃣  MANAGEMENT - ACTUATOR & MONITORING
# ============================================================================
MANAGEMENT_SERVER_PORT=9090

# ============================================================================
# 6️⃣  LOGGING - MINIMAL EN PRODUCTION
# ============================================================================
LOGGING_LEVEL_ROOT=ERROR
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN
LOGGING_LEVEL_COM_SPEEDLINE=WARN
LOGGING_LEVEL_COM_SPEEDLINE_DELIVERY=WARN

