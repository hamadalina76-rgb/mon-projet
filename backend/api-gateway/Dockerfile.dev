# ==============================================================================
# Dockerfile.dev — API Gateway (Cloud Run)
# - Cloud Run = 1 seul port (PORT=8080)
# - Actuator doit être sur le même port
# ==============================================================================

FROM maven:3.9.6-eclipse-temurin-17 AS builder
WORKDIR /workspace

# ✅ FIX: Copier d'abord les pom.xml pour optimiser le cache des dépendances
COPY pom.xml ./pom.xml
COPY api-gateway/pom.xml ./api-gateway/pom.xml

# Télécharger les dépendances avant de copier le code source
RUN mvn -pl api-gateway -am dependency:go-offline -q || true

# ✅ Copier les sources
COPY api-gateway/src ./api-gateway/src

# Build uniquement api-gateway
RUN mvn -q -DskipTests -pl api-gateway -am clean package


FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

# User non-root (bonne pratique)
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

COPY --from=builder /workspace/api-gateway/target/*.jar /app/app.jar
RUN chown appuser:appuser /app/app.jar

# Cloud Run injecte PORT, on expose 8080 (info seulement)
EXPOSE 8080

# Variables runtime
ENV SPRING_PROFILES_ACTIVE=dev
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseG1GC -Dspring.output.ansi.enabled=ALWAYS"

USER appuser
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]