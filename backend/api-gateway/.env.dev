# Profil
SPRING_PROFILES_ACTIVE=dev
SPRING_APPLICATION_NAME=api-gateway

# Eureka sur la machine (OK)
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka:eureka123@host.docker.internal:8761/eureka/

# Redis dans docker-compose
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=speedline-super-secret-key-for-jwt-token-generation-minimum-256-bits

# Actuator
MANAGEMENT_SERVER_PORT=9090

# Pub/Sub emulator dans docker-compose
GCP_PROJECT_ID=speedline-local
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085