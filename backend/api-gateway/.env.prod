# Configuration environnement production - SÉCURISÉ
SPRING_PROFILES_ACTIVE=prod
SPRING_APPLICATION_NAME=api-gateway
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka:eureka123@eureka:8761/eureka/
