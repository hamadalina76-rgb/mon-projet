# ==============================================================================
# Dockerfile.dev — Eureka Server (Cloud Run)
# ⚠️  CONTEXTE DOCKER : doit être lancé depuis backend/
#     docker build -f eureka-server/Dockerfile.dev .
# ==============================================================================

FROM maven:3.9.6-eclipse-temurin-17 AS builder
WORKDIR /workspace

COPY pom.xml ./pom.xml
COPY eureka-server/pom.xml ./eureka-server/pom.xml

RUN mvn -pl eureka-server -am dependency:go-offline -q || true

COPY eureka-server/src ./eureka-server/src

RUN mvn -q -DskipTests -pl eureka-server -am clean package


FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

COPY --from=builder /workspace/eureka-server/target/*.jar /app/app.jar
RUN chown appuser:appuser /app/app.jar

EXPOSE 8080

ENV SPRING_PROFILES_ACTIVE=dev
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseG1GC -Dspring.output.ansi.enabled=ALWAYS"

USER appuser
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]