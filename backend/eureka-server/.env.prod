# ============================================================================
# VARIABLES ENVIRONNEMENT - EUREKA SERVER PRODUCTION
# ============================================================================

SPRING_PROFILES_ACTIVE=prod
SPRING_APPLICATION_NAME=eureka-server

# ⚠️  EN PRODUCTION : Utiliser Secrets Manager
EUREKA_USER=${EUREKA_USER_PROD}
EUREKA_PASSWORD=${EUREKA_PASSWORD_PROD}

EUREKA_INSTANCE_HOSTNAME=eureka-prod

EUREKA_CLIENT_REGISTER_WITH_EUREKA=false
EUREKA_CLIENT_FETCH_REGISTRY=false

SERVER_PORT=8761

EUREKA_SERVER_ENABLE_SELF_PRESERVATION=true
EUREKA_SERVER_EVICTION_INTERVAL_TIMER_IN_MS=30000

MANAGEMENT_SERVER_PORT=9090

LOG_LEVEL=ERROR
LOGGING_LEVEL_COM_NETFLIX_EUREKA=WARN
LOGGING_LEVEL_COM_NETFLIX_DISCOVERY=WARN

