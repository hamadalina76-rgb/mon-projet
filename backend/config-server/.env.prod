# ============================================================================
# VARIABLES ENVIRONNEMENT - CONFIG SERVER PRODUCTION
# ============================================================================
# Configuration environnement production - SÉCURISÉ

SPRING_PROFILES_ACTIVE=prod
SPRING_APPLICATION_NAME=config-server

EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka:eureka123@eureka:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true

# ⚠️  EN PRODUCTION : Utiliser Secrets Manager (AWS, Vault)
CONFIG_USER=${CONFIG_USER_PROD}
CONFIG_PASSWORD=${CONFIG_PASSWORD_PROD}

# Git backend (recommandé en prod)
CONFIG_SERVER_GIT_URI=${GIT_REPO_URI}
CONFIG_SERVER_GIT_USERNAME=${GIT_USERNAME}
CONFIG_SERVER_GIT_PASSWORD=${GIT_PASSWORD}

MANAGEMENT_SERVER_PORT=9090
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

SERVER_PORT=8888
SERVER_SERVLET_ENCODING_CHARSET=UTF-8

LOG_LEVEL=ERROR
LOGGING_LEVEL_ROOT=ERROR
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_CLOUD_CONFIG=WARN
LOGGING_LEVEL_COM_SPEEDLINE=WARN

