# ============================================================================
# FICHIER DE CONFIGURATION ENVIRONNEMENT DÉVELOPPEMENT (.env.dev)
# ============================================================================
# CONFIG SERVER - Service de configuration centralisée
#
# USAGE:
# - source .env.dev  (Linux/Mac)
# - Charger manuellement dans votre IDE
# ============================================================================

# ============================================================================
# 1️⃣  CONFIGURATION SPRING BOOT - PROFIL ET ENVIRONNEMENT
# ============================================================================
SPRING_PROFILES_ACTIVE=dev
SPRING_APPLICATION_NAME=config-server

# ============================================================================
# 2️⃣  EUREKA SERVER - DÉCOUVERTE DE SERVICES
# ============================================================================
# URL du serveur Eureka pour l'enregistrement du config-server
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka:eureka123@localhost:8761/eureka/

# Alternative pour environnement local sans Docker :
# EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka:eureka123@localhost:8761/eureka/

EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
EUREKA_CLIENT_REGISTRY_FETCH_INTERVAL_SECONDS=30

# ============================================================================
# 3️⃣  CONFIG SERVER - AUTHENTIFICATION
# ============================================================================
# Identifiants pour accéder au config server
# ⚠️  EN DEV : Peuvent être simples, EN PROD : À renforcer

CONFIG_USER=config
CONFIG_PASSWORD=config123

# ============================================================================
# 4️⃣  CONFIG SERVER - STOCKAGE DES CONFIGURATIONS
# ============================================================================
# Type de stockage : native (classpath), git, vault, etc.
CONFIG_SERVER_SEARCH_LOCATIONS=classpath:/config

# Alternative pour Git :
# CONFIG_SERVER_GIT_URI=https://github.com/speedline/config-repo.git
# CONFIG_SERVER_GIT_USERNAME=${GIT_USERNAME}
# CONFIG_SERVER_GIT_PASSWORD=${GIT_PASSWORD}

# ============================================================================
# 5️⃣  MANAGEMENT / ACTUATOR
# ============================================================================
MANAGEMENT_SERVER_PORT=9090

# Endpoints exposés
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,refresh,configprops

# ============================================================================
# 6️⃣  SERVEUR HTTP
# ============================================================================
# Port sur lequel le config-server écoute
SERVER_PORT=8888

# Charset
SERVER_SERVLET_ENCODING_CHARSET=UTF-8

# ============================================================================
# 7️⃣  LOGGING
# ============================================================================
LOG_LEVEL=DEBUG
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_CLOUD_CONFIG=DEBUG
LOGGING_LEVEL_COM_SPEEDLINE=DEBUG

