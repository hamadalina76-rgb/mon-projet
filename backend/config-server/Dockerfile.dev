# ==============================================================================
# Dockerfile.dev — Config Server (Cloud Run)
# ⚠️  CONTEXTE DOCKER : doit être lancé depuis backend/
#     docker build -f config-server/Dockerfile.dev .
# ==============================================================================

FROM maven:3.9.6-eclipse-temurin-17 AS builder
WORKDIR /workspace

COPY pom.xml ./pom.xml
COPY config-server/pom.xml ./config-server/pom.xml

RUN mvn -pl config-server -am dependency:go-offline -q || true

COPY config-server/src ./config-server/src

RUN mvn -q -DskipTests -pl config-server -am clean package


FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

COPY --from=builder /workspace/config-server/target/*.jar /app/app.jar
RUN chown appuser:appuser /app/app.jar

EXPOSE 8080

ENV SPRING_PROFILES_ACTIVE=dev
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseG1GC -Dspring.output.ansi.enabled=ALWAYS"

USER appuser
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]