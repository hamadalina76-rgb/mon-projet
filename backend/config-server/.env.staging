# ============================================================================
# VARIABLES ENVIRONNEMENT - CONFIG SERVER STAGING
# ============================================================================
# Configuration environnement de pré-production

SPRING_PROFILES_ACTIVE=staging
SPRING_APPLICATION_NAME=config-server

EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka:eureka123@eureka:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true

CONFIG_USER=config-staging
CONFIG_PASSWORD=config-staging-secure-password

CONFIG_SERVER_SEARCH_LOCATIONS=classpath:/config

MANAGEMENT_SERVER_PORT=9090
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,refresh,configprops

SERVER_PORT=8888
SERVER_SERVLET_ENCODING_CHARSET=UTF-8

LOG_LEVEL=INFO
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_CLOUD_CONFIG=INFO
LOGGING_LEVEL_COM_SPEEDLINE=INFO

