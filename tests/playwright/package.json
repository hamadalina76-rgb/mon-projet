{
  "name": "speedline-test-robot",
  "version": "1.0.0",
  "description": "Automated testing robot for Speed Line & Delivery App",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:admin": "npx playwright test --project=admin-panel",
    "test:partner": "npx playwright test --project=partner-dashboard",
    "test:api": "npx playwright test --project=api-tests",
    "test:smoke": "npx playwright test api/smoke.api.spec.ts",
    "test:security": "npx playwright test api/security.api.spec.ts",
    "test:contracts": "npx playwright test api/contracts.api.spec.ts",
    "test:websocket": "npx playwright test api/websocket.api.spec.ts",
    "test:visual": "npx playwright test visual-regression",
    "test:a11y": "npx playwright test accessibility",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "report": "npx playwright show-report",
    "report:allure": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report",
    "seed": "node ../seed/seed-test-data.js",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.27.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@types/ws": "^8.18.1",
    "ws": "^8.20.0"
  }
}
