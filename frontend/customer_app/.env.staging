# Staging Environment Configuration
APP_ENV=staging
APP_NAME=SpeedLine Customer Staging

# API Configuration
API_BASE_URL=https://staging-api.speedline.com/api/v1
API_TIMEOUT=30000

# WebSocket
WS_URL=wss://staging-api.speedline.com/ws

# Google Maps
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_STAGING

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Firebase
FIREBASE_ENABLED=true

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_DEBUG_LOGGING=true
