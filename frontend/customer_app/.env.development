# Development Environment Configuration
APP_ENV=development
APP_NAME=SpeedLine Customer Dev

# API Configuration
# Note: Pour émulateur Android, utiliser 10.0.2.2 au lieu de localhost
# Pour iOS simulator ou appareil physique, utiliser l'IP locale
API_BASE_URL=http://10.0.2.2:8080/api/v1
API_TIMEOUT=30000
LOG_NETWORK=true

# WebSocket
WS_URL=ws://localhost:8080/ws

# Google Maps
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_DEV

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Firebase (optional)
FIREBASE_ENABLED=false

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASHLYTICS=false
ENABLE_DEBUG_LOGGING=true
